# .envrc.example — direnv で読み込む環境変数のサンプル
# cp .envrc.example .envrc して値を設定してください。
# .envrc は .gitignore されているため、機密情報を書いても問題ありません。

# サーバーポート（デフォルト: 1099）
# export SERVER_PORT=1099

# Database
export DB_HOST=localhost
export DB_PORT=3306
export DB_USER=root
export DB_PASSWORD=rootpassword
export DB_NAME=app_db
export DB_TLS=false
export DB_MAX_OPEN_CONNS=25
export DB_MAX_IDLE_CONNS=25
export DB_CONN_MAX_LIFETIME=5m

# JWT
export JWT_SECRET_KEY=change-me-with-a-long-random-string
